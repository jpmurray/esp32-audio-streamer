[env:wemos_d1_mini32]
; Local, untracked settings (Wi‑Fi onboarding + audio/tuning)
; Copy this file to local_env.ini and edit values

build_flags =
  ; Wi‑Fi runtime onboarding is enabled by default.
  ; If no saved credentials exist, first boot starts a setup AP and serves
  ; http://192.168.4.1/ for Wi‑Fi setup.
  ; Optional legacy provisioning seed: if uncommented and non-placeholder,
  ; the firmware tries these once and persists them to NVS on success.
  ; '-D WIFI_SSID="Your SSID"'      ; optional seed SSID
  ; '-D WIFI_PASS="Your Password"'   ; optional seed password
  -D WIFI_TX_POWER_DBM=15           ; Target TX power in dBm (−1..19.5 mapped)

  ; Wi‑Fi onboarding AP
  ; '-D WIFI_SETUP_AP_SSID="ESP32-Audio-Setup"' ; base AP SSID
  ; '-D WIFI_SETUP_AP_PASS=""'                   ; empty=open, 8+ chars=WPA2
  ; -D WIFI_SETUP_AP_UNIQUE_SUFFIX=1             ; append MAC suffix to AP SSID
  ; -D WIFI_CONNECT_TIMEOUT_MS=20000             ; bounded STA connect attempt

  ; Audio
  ; Audio profile (runtime setting, overrides SAMPLE_RATE_HZ after audio restart)
  ; Options: 0 = quality_48k (48 kHz, default), 1 = stability_24k (24 kHz)
  ; Change via the /audio UI page or POST /api/set {"audio_profile": "stability_24k"}
  ; SAMPLE_RATE_HZ below is a compile-time seed; the runtime profile takes precedence.
  ; AUDIO_PROFILE_DEFAULT controls first boot / invalid NVS fallback only.
  -D SAMPLE_RATE_HZ=48000           ; Compile-time seed sample rate (Hz)
  ; -D AUDIO_PROFILE_DEFAULT=AUDIO_PROFILE_STABILITY_24K ; safer RTSP/BirdNET-Go default
  -D CONVERT_SHIFT=11               ; 32→16-bit shift; lower is louder
  -D HPF_ENABLE=1                   ; 1=enable DC-block/HPF, 0=off
  -D HPF_CUTOFF_HZ=100              ; HPF cutoff in Hz

  ; Producer / buffering
  -D CHUNK_FRAMES=1024              ; Producer frames per chunk
  -D RB_CAPACITY_BYTES=262144        ; Ring buffer size (bytes) — 256 KB default (~1.4 s at 48 kHz/16-bit)
  -D DMA_BUF_COUNT_CFG=4             ; I2S DMA buffer count

  ; I2S producer task placement
  ; Default: core 1 (away from Wi-Fi/lwIP on core 0), priority 4, stack 6144 words.
  ; Override to move the task if needed (e.g. restore legacy core 0 placement).
  ; -D I2S_TASK_CORE=1               ; CPU core (0 or 1); default 1
  ; -D I2S_TASK_PRIORITY=4           ; FreeRTOS priority; default 4
  ; -D I2S_TASK_STACK_WORDS=6144     ; Stack words; default 6144

  ; Channel and pins
  -D USE_RIGHT_CHANNEL=1            ; 1=RIGHT, 0=LEFT channel
  -D PIN_I2S_WS=25                  ; WS/LRCLK pin
  -D PIN_I2S_SCK=33                 ; BCLK/SCK pin
  -D PIN_I2S_SD=32                  ; SD/DOUT pin
  -D I2S_PORT_NUM=0                 ; I2S port index

  ; Location (for civil dawn/dusk)
  -D LAT=51.4630911                    ; Latitude in degrees (positive north)
  -D LON=-3.1678763                   ; Longitude in degrees (negative west)
  
  ; Power / stability
  -D ENABLE_POWER_SCHEDULING=1       ; 1=deep sleep at night, 0=run continuously
  -D ENABLE_BROWNOUT_DISABLE=0       ; 0=leave brownout detector enabled (diagnostic default)
                                     ;   set to 1 only as a temporary workaround for boards
                                     ;   with marginal power supplies — hides brownout resets

  ; Deep sleep (default: enabled)
  ; Set to 0 to prevent the firmware from ever calling esp_deep_sleep_start().
  ; The device will stay awake at night and log a message instead of sleeping.
  ; Useful for local testing / serial debugging.
  ; -D ENABLE_DEEP_SLEEP=0           ; uncomment to disable deep sleep

  ; HTTP server
  -D SERVER_PORT=80                 ; HTTP port

  ; RTSP server (RTSP/TCP on port 8554 by default)
  ; URL: rtsp://<device-ip>:8554/audio/
  ; Set RTSP_PORT=0 to disable RTSP entirely.
  ; -D RTSP_PORT=8554               ; RTSP listen port (default: 8554)
  ; -D RTSP_MAX_SAMPLE_RATE_HZ=24000 ; reject RTSP DESCRIBE above this rate; 0 disables guard

  ; Local timezone (POSIX TZ string)
  ; Examples:
  ;   EST5EDT,M3.2.0/2,M11.1.0/2   (US Eastern with DST)
  ;   CET-1CEST,M3.5.0/2,M10.5.0/3 (Central Europe with DST)
  ;   UTC0                          (UTC)
  '-D LOCAL_TZ="UTC0"'

  ; Logging level (compile-time)
  ; 1 = errors only, 2 = info+warn+error (default), 3 = verbose/debug
  -D LOG_LEVEL=2                    ; 1=errors, 2=info/warn, 3=debug

  ; Remote UDP/syslog logging (optional, compile-time only)
  ; Logs are sent as best-effort RFC3164-style UDP datagrams.
  ; Dropped silently when Wi-Fi is unavailable. No retries.
  ; REMOTE_LOG_HOST must be an IPv4 literal — DNS is never used.
  ;
  ; -D ENABLE_REMOTE_LOG=1
  ; '-D REMOTE_LOG_HOST="192.168.1.10"'   ; IPv4 literal required
  ; -D REMOTE_LOG_PORT=514
  ; '-D REMOTE_LOG_DEVICE="esp32-audio-streamer"'
  ; -D REMOTE_LOG_MIN_LEVEL=2             ; 1=errors, 2=warn+error, 3=info+..., 4=debug+all

  ; Periodic health log (uptime, heap, net, stream, audio drop stats)
  ; Set to 0 to disable. Default: 60000 (every 60 s).
  ; Wi-Fi RSSI quality thresholds (firmware classification; affects API, UI warnings, and log rate-limiting)
  ; -D WIFI_RSSI_WARN_DBM=-70          ; RSSI at or below this = 'weak' (default -70 dBm)
  ; -D WIFI_RSSI_UNSTABLE_DBM=-75      ; RSSI at or below this = 'unstable' (default -75 dBm)
  ; -D WIFI_RSSI_WARN_LOG_INTERVAL_MS=60000 ; min ms between repeated weak/unstable RSSI log warnings

  ; Periodic health log (uptime, heap, net, stream, audio drop stats)
  ; Set to 0 to disable. Default: 60000 (every 60 s).
  ; -D HEALTH_LOG_INTERVAL_MS=60000

  ; Stream format (toggle raw PCM vs WAV header)
  ; 0 = raw `audio/L16` (default), 1 = `audio/x-wav` with streaming header
  ; -D STREAM_WAV_ENABLE=1           ; 1 to enable WAV header

  ; Stream transport stability tunables
  ; These knobs control how aggressively the stream server detects a broken or
  ; stalled client and terminates the session.  Increase if you see spurious
  ; reconnects; decrease for faster stall detection on unreliable networks.
  ;
  ; HTTP transport
  ; -D STREAM_WRITE_STALL_LIMIT=500   ; consecutive zero-byte write rounds before hangup (default: 500)
  ; -D STREAM_IDLE_TIMEOUT_COUNT=30   ; consecutive empty ring-buffer reads (~1 s each) before hangup (default: 30)
  ;
  ; RTSP transport
  ; -D RTSP_WRITE_STALL_LIMIT=500     ; consecutive zero-byte RTP write rounds before session teardown (default: 500)
  ; -D RTSP_IDLE_TIMEOUT_COUNT=30     ; consecutive empty ring-buffer reads before RTSP hangup (default: 30)
  ; -D RTSP_SETUP_TIMEOUT_MS=30000    ; ms of inactivity between SETUP and PLAY before session is dropped (default: 30000)
