[env:wemos_d1_mini32]
; Local, untracked settings (Wi‑Fi onboarding + audio/tuning)
; Copy this file to local_env.ini and edit values

build_flags =
  ; Wi‑Fi runtime onboarding is enabled by default.
  ; If no saved credentials exist, first boot starts a setup AP and serves
  ; http://192.168.4.1/ for Wi‑Fi setup.
  ; Optional legacy provisioning seed: if uncommented and non-placeholder,
  ; the firmware tries these once and persists them to NVS on success.
  ; '-D WIFI_SSID="Your SSID"'      ; optional seed SSID
  ; '-D WIFI_PASS="Your Password"'   ; optional seed password
  -D WIFI_TX_POWER_DBM=15           ; Target TX power in dBm (−1..19.5 mapped)

  ; Wi‑Fi onboarding AP
  ; '-D WIFI_SETUP_AP_SSID="ESP32-Audio-Setup"' ; base AP SSID
  ; '-D WIFI_SETUP_AP_PASS=""'                   ; empty=open, 8+ chars=WPA2
  ; -D WIFI_SETUP_AP_UNIQUE_SUFFIX=1             ; append MAC suffix to AP SSID
  ; -D WIFI_CONNECT_TIMEOUT_MS=20000             ; bounded STA connect attempt

  ; Audio
  -D SAMPLE_RATE_HZ=48000          ; Sample rate in Hz
  -D CONVERT_SHIFT=11               ; 32→16-bit shift; lower is louder
  -D HPF_ENABLE=1                   ; 1=enable DC-block/HPF, 0=off
  -D HPF_CUTOFF_HZ=100              ; HPF cutoff in Hz

  ; Producer / buffering
  -D CHUNK_FRAMES=1024              ; Producer frames per chunk
  -D RB_CAPACITY_BYTES=65536         ; Ring buffer size (bytes)
  -D DMA_BUF_COUNT_CFG=4             ; I2S DMA buffer count

  ; Channel and pins
  -D USE_RIGHT_CHANNEL=1            ; 1=RIGHT, 0=LEFT channel
  -D PIN_I2S_WS=25                  ; WS/LRCLK pin
  -D PIN_I2S_SCK=33                 ; BCLK/SCK pin
  -D PIN_I2S_SD=32                  ; SD/DOUT pin
  -D I2S_PORT_NUM=0                 ; I2S port index

  ; Location (for civil dawn/dusk)
  -D LAT=51.4630911                    ; Latitude in degrees (positive north)
  -D LON=-3.1678763                   ; Longitude in degrees (negative west)
  
  ; Power / stability
  -D ENABLE_POWER_SCHEDULING=1       ; 1=deep sleep at night, 0=run continuously
  -D ENABLE_BROWNOUT_DISABLE=1       ; 1=disable brownout detector, 0=leave enabled

  ; Deep sleep (default: enabled)
  ; Set to 0 to prevent the firmware from ever calling esp_deep_sleep_start().
  ; The device will stay awake at night and log a message instead of sleeping.
  ; Useful for local testing / serial debugging.
  ; -D ENABLE_DEEP_SLEEP=0           ; uncomment to disable deep sleep

  ; HTTP server
  -D SERVER_PORT=80                 ; HTTP port

  ; Local timezone (POSIX TZ string)
  ; Examples:
  ;   EST5EDT,M3.2.0/2,M11.1.0/2   (US Eastern with DST)
  ;   CET-1CEST,M3.5.0/2,M10.5.0/3 (Central Europe with DST)
  ;   UTC0                          (UTC)
  '-D LOCAL_TZ="UTC0"'

  ; Logging level (compile-time)
  ; 1 = errors only, 2 = info+warn+error, 3 = verbose/debug
  -D LOG_LEVEL=2                    ; 1=errors, 2=info/warn, 3=debug

  ; Stream format (toggle raw PCM vs WAV header)
  ; 0 = raw `audio/L16` (default), 1 = `audio/x-wav` with streaming header
  ; -D STREAM_WAV_ENABLE=1           ; 1 to enable WAV header
